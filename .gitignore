# Data policy:
# - keep docs/scripts/layout placeholders in data/
# - do not commit raw or generated dataset binaries
data/**/*.tif
data/**/*.tiff
data/**/*.png
data/**/*.jpg
data/**/*.jpeg
data/**/*.bmp
data/**/*.webp
data/**/*.gif
data/**/*.npy
data/**/*.npz
data/**/*.h5
data/**/*.hdf5
data/**/*.db
data/**/*.lmdb
data/**/*.zip
data/**/*.tar
data/**/*.gz
data/**/*.txt
data/**/*.py
data/**/cache/
data/**/tmp/

# Allow lightweight data docs/scripts/placeholders
!data/**/*.md
!data/**/*.yaml
!data/**/*.yml
!data/**/.gitkeep
